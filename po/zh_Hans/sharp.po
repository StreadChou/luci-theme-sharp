msgstr "菜单加载失败，请刷新"

msgctxt "sharp"
msgid "Mobile layout"
msgstr "手机端布局"

msgctxt "sharp"
msgid "Navigation"
msgstr "导航"

msgctxt "sharp"
msgid "No matching menu"
msgstr "没有找到相关菜单"

msgctxt "sharp"
msgid "Open navigation"
msgstr "打开导航"

msgctxt "sharp"
msgid "OpenWrt control panel"
msgstr "OpenWrt 控制面板"

msgctxt "sharp"
msgid "Password"
msgstr "密码"

msgctxt "sharp"
msgid "QUICK ACCESS"
msgstr "快速访问"

msgctxt "sharp"
msgid "Reboot router"
msgstr "重启路由器"

