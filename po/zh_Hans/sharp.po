msgid "Invalid username and/or password! Please try again."
msgstr "用户名或密码错误，请重试。"

msgctxt "sharp"
msgid "Light"
msgstr "浅色"

msgctxt "sharp"
msgid "Layout changes apply immediately and are saved in this browser."
msgstr "布局切换立即生效，并保存在当前浏览器中。"

